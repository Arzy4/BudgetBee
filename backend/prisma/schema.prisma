generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CARD
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum CategoryName {
  SALARY
  GIFTS
  INVESTMENT
  BONUS
  FOOD_AND_DRINKS
  HEALTH
  FASHION
  TRANSPORTATION
}

model User {
  id           Int     @id @default(autoincrement())
  fullName     String
  email        String  @unique
  phoneNumber  String?
  passwordHash String

  profileImage   String?
  profileImageId String?

  passwordResets PasswordReset[]

  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  refreshSessions RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id   Int          @id @default(autoincrement())
  name String
  type CategoryType

  userId Int
  user   User @relation(fields: [userId], references: [id])

  transactions Transaction[]
  budgets      Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  description   String?
  amount        Decimal         @db.Decimal(18, 2)
  type          TransactionType
  paymentMethod PaymentMethod?
  date          DateTime        @default(now())
  receiptKey    String?
  title         String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id     Int     @id @default(autoincrement())
  amount Decimal @db.Decimal(18, 2)
  month  Int
  year   Int

  userId Int
  user   User @relation(fields: [userId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@index([categoryId])
  @@map("budgets")
}

model RefreshSession {
  id                 Int       @id @default(autoincrement())
  sessionId          String    @unique @default(uuid())
  userId             Int
  tokenHash          String    @unique
  accessTokenVersion Int       @default(1)
  expiresAt          DateTime
  lastActivityAt     DateTime  @default(now())
  lastRotatedAt      DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordReset {
  id        Int    @id @default(autoincrement())
  requestId String @unique @default(uuid())
  userId    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash             String
  codeExpiresAt        DateTime
  verificationAttempts Int      @default(0)

  verifiedAt          DateTime?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_resets")
}
